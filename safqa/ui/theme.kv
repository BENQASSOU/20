#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import C safqa.ui.widgets.C

<Label>:
    color: C.text
    font_size: sp(14)

<WrapLabel>:
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1]
    halign: "left"
    valign: "top"
    markup: True

<Title>:
    font_size: sp(18)
    bold: True
    color: C.text

<Muted>:
    font_size: sp(12.5)
    color: C.muted

<Card>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(14), dp(12)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: C.border
        RoundedRectangle:
            pos: self.x, self.y - dp(1)
            size: self.width, self.height + dp(1)
            radius: [dp(14)]
        Color:
            rgba: self.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: self.accent if self.accent else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x, self.y
            size: dp(5), self.height
            radius: [dp(14), 0, 0, dp(14)]

<Btn>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    size_hint_y: None
    height: dp(44)
    font_size: sp(14.5)
    bold: True
    color: self.fg
    canvas.before:
        Color:
            rgba: (self.bg[0] * 0.85, self.bg[1] * 0.85, self.bg[2] * 0.85, self.bg[3]) if self.state == "down" else self.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(11)]
        Color:
            rgba: self.line if self.line else (0, 0, 0, 0)
        Line:
            rounded_rectangle: self.x + dp(0.5), self.y + dp(0.5), self.width - dp(1), self.height - dp(1), dp(11)
            width: dp(1)

<Chip>:
    size_hint: None, None
    size: self.texture_size[0] + dp(16), dp(24)
    font_size: sp(11.5)
    bold: True
    color: self.fg
    canvas.before:
        Color:
            rgba: self.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<Field>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(3)
    Label:
        text: root.label
        size_hint_y: None
        height: dp(18)
        text_size: self.size
        halign: "left"
        font_size: sp(12.5)
        color: C.muted
    TextInput:
        id: inp
        text: root.text
        hint_text: root.hint
        multiline: root.multiline
        password: root.password
        input_filter: root.input_filter
        size_hint_y: None
        height: dp(96) if root.multiline else dp(44)
        padding: dp(10), dp(12)
        font_size: sp(15)
        background_normal: ""
        background_active: ""
        background_color: C.field
        foreground_color: C.text
        cursor_color: C.primary
        write_tab: False
        on_text: root.text = self.text

<ProgressBarH>:
    size_hint_y: None
    height: dp(8)
    canvas:
        Color:
            rgba: C.track
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(4)]
        Color:
            rgba: self.color
        RoundedRectangle:
            pos: self.pos
            size: max(dp(8) if self.value > 0 else 0, self.width * min(1, max(0, self.value))), self.height
            radius: [dp(4)]

<AppBar>:
    size_hint_y: None
    height: dp(64)
    padding: dp(8), dp(8)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: C.primary
        Rectangle:
            pos: self.pos
            size: self.size
    Btn:
        text: "‹"
        font_size: sp(30)
        size_hint_x: None
        width: dp(44) if root.back else 0
        opacity: 1 if root.back else 0
        disabled: not root.back
        bg: 0, 0, 0, 0
        fg: 1, 1, 1, 1
        on_release: root.dispatch("on_back")
    BoxLayout:
        orientation: "vertical"
        padding: dp(6), 0
        Label:
            text: root.title
            font_size: sp(19)
            bold: True
            color: 1, 1, 1, 1
            text_size: self.size
            halign: "left"
            valign: "bottom" if root.subtitle else "middle"
            shorten: True
            shorten_from: "right"
        Label:
            text: root.subtitle
            font_size: sp(12)
            color: 1, 1, 1, 0.75
            text_size: self.size
            halign: "left"
            valign: "top"
            size_hint_y: 0.8 if root.subtitle else 0.001
            shorten: True
    BoxLayout:
        id: actions
        size_hint_x: None
        width: self.minimum_width
        spacing: dp(4)
        padding: 0, dp(6)

<NavBar>:
    size_hint_y: None
    height: dp(60)
    canvas.before:
        Color:
            rgba: C.surface
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: C.border
        Rectangle:
            pos: self.x, self.top - dp(1)
            size: self.width, dp(1)

<TabStrip>:
    size_hint_y: None
    height: dp(48)
    do_scroll_y: False
    bar_width: 0
    canvas.before:
        Color:
            rgba: C.surface
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: C.border
        Rectangle:
            pos: self.pos
            size: self.width, dp(1)
    BoxLayout:
        id: row
        size_hint_x: None
        width: self.minimum_width
        padding: dp(6), 0

<Page>:
    do_scroll_x: False
    bar_width: dp(3)
    BoxLayout:
        id: body
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: dp(14), dp(14), dp(14), dp(28)
        spacing: dp(10)

<Select>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: C.text
    size_hint_y: None
    height: dp(44)
    font_size: sp(14)
    halign: "left"
    valign: "middle"
    text_size: self.width - dp(44), self.height
    shorten: True
    shorten_from: "right"
    canvas.before:
        Color:
            rgba: C.surface
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(11)]
        Color:
            rgba: C.border
        Line:
            rounded_rectangle: self.x + dp(0.5), self.y + dp(0.5), self.width - dp(1), self.height - dp(1), dp(11)
            width: dp(1)
    canvas.after:
        Color:
            rgba: C.primary
        Line:
            points: [self.right - dp(26), self.center_y + dp(3), self.right - dp(20), self.center_y - dp(3), self.right - dp(14), self.center_y + dp(3)]
            width: dp(1.5)
